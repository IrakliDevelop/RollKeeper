exports[`StudioPanel / InitiativeTab / TurnControl legacy rendering > renders InitiativeTab inactive unchanged 1`] = `"<div class="space-y-2 px-3 py-4"><p class="text-muted text-xs">Start combat from the encounter page.</p><a target="_blank" rel="noopener noreferrer" class="text-accent-blue-text text-xs font-semibold hover:underline" href="/x">Encounter page ↗</a></div>"`;

exports[`StudioPanel / InitiativeTab / TurnControl legacy rendering > renders StudioPanel collapsed unchanged 1`] = `"<button title="Expand combat panel" class="bg-surface-raised border-divider text-heading pointer-events-auto fixed top-[var(--dm-vtt-panel-top,8rem)] right-0 flex min-h-[44px] items-center gap-1.5 rounded-l-2xl border px-3 text-xs font-bold tracking-wider shadow-xl"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-swords h-4 w-4" aria-hidden="true"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline><line x1="13" x2="19" y1="19" y2="13"></line><line x1="16" x2="20" y1="16" y2="20"></line><line x1="19" x2="21" y1="21" y2="19"></line><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline><line x1="5" x2="9" y1="14" y2="18"></line><line x1="7" x2="4" y1="17" y2="20"></line><line x1="3" x2="5" y1="19" y2="21"></line></svg> COMBAT</button>"`;

exports[`StudioPanel / InitiativeTab / TurnControl legacy rendering > renders StudioPanel initiative active unchanged 1`] = `"<div class="bg-surface-raised border-divider pointer-events-auto fixed top-[var(--dm-vtt-panel-top,8rem)] right-0 flex w-[min(390px,40vw)] flex-col overflow-hidden rounded-l-2xl border shadow-xl max-h-[70vh]" style="max-height: min(70dvh, calc(100dvh - var(--dm-vtt-panel-top, 8rem) - 0.75rem));" data-testid="dm-vtt-studio-panel" data-active-tab="initiative"><div class="border-divider flex shrink-0 items-center justify-between gap-2 border-b px-2 py-1.5"><div class="flex items-center gap-1"><button class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-gradient-to-r from-emerald-600 to-emerald-700 text-white shadow-md hover:from-emerald-700 hover:to-emerald-800 focus-visible:ring-emerald-500 active:scale-[0.98] h-10 px-5 min-h-[44px] text-xs" aria-label="Initiative"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-swords h-4 w-4" aria-hidden="true"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline><line x1="13" x2="19" y1="19" y2="13"></line><line x1="16" x2="20" y1="16" y2="20"></line><line x1="19" x2="21" y1="21" y2="19"></line><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline><line x1="5" x2="9" y1="14" y2="18"></line><line x1="7" x2="4" y1="17" y2="20"></line><line x1="3" x2="5" y1="19" y2="21"></line></svg> Initiative</button><button class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 te