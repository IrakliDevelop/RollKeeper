exports[`CombatantDetail legacy rendering > renders the npc detail unchanged 1`] = `"<div class="flex flex-col"><div class="space-y-2 p-4"><div class="flex items-start gap-2"><div class="min-w-0 flex-1"><div class="flex items-center gap-1"><h2 class="font-display text-heading min-w-0 truncate text-2xl leading-tight font-bold">Captain Vex</h2><button aria-label="Rename" title="Rename" class="text-faint hover:text-body hover:bg-surface-raised flex h-11 w-11 shrink-0 items-center justify-center rounded transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg></button></div><div class="mt-1 flex flex-wrap items-center gap-1.5"><span class="rounded-full border px-2 py-0.5 text-[11px] font-semibold bg-accent-amber-bg text-accent-amber-text border-accent-amber-border">NPC</span><span title="Stat edits sync to the NPC library record" class="bg-accent-blue-bg text-accent-blue-text border-accent-blue-border inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link2 lucide-link-2" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" x2="16" y1="12" y2="12"></line></svg>Library<span class="sr-only">: stat edits sync to the NPC library record</span></span></div><div class="mt-1 flex min-w-0 items-center gap-1.5"><div class="flex shrink-0 items-center gap-1.5"><span class="text-muted text-xs font-semibold">Init</span><inpu