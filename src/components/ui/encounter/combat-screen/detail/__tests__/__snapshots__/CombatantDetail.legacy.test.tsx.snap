exports[`CombatantDetail legacy rendering > renders the player detail unchanged 1`] = `"<div class="flex flex-col"><div class="space-y-2 p-4"><div class="flex items-start gap-2"><div class="min-w-0 flex-1"><div class="flex items-center gap-1"><h2 class="font-display text-heading min-w-0 truncate text-2xl leading-tight font-bold">Aria</h2></div><div class="mt-1 flex flex-wrap items-center gap-1.5"><span class="rounded-full border px-2 py-0.5 text-[11px] font-semibold bg-accent-blue-bg text-accent-blue-text border-accent-blue-border">Player</span></div><div class="mt-1 flex min-w-0 items-center gap-1.5"><div class="flex shrink-0 items-center gap-1.5"><span class="text-muted text-xs font-semibold">Init</span><span class="text-body text-xs">+3</span></div></div></div><div class="flex shrink-0 items-center gap-1.5"><button class="text-accent-red-text hover:bg-accent-red-bg rounded p-1 transition-colors" title="Remove from combat"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></div></div><div class="bg-surface-secondary border-divider space-y-3 rounded-xl border p-4"><div class="flex items-start justify-between gap-4"><div class="flex flex-wrap items-baseline gap-1"><span class="font-display text-3xl font-bold tabular-nums text-accent-emerald-text">20</span><span class="text-muted text-sm font-medium">/</span><span class="text-muted text-sm tabular-nums">31</span><span class="text-faint ml-1 text-xs">(+2 temp, synced)</span></div><div class="flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield text-muted shrink-0" aria-hidden="true"><path d="