# Upstash Redis (required for campaign sync)
# For local dev with docker-compose: use http://localhost:8079 and local_dev_token
# For production: get these from the Upstash dashboard
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token

# AWS S3 (for avatar uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=eu-central-1
AWS_S3_BUCKET_NAME=rollkeeper-images

# tldraw license key
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=1234567890

# Live battle map sync (relay)
BATTLEMAP_RELAY_SECRET=dev-secret-change-me
NEXT_PUBLIC_BATTLEMAP_RELAY_URL=ws://localhost:8787

# Auth-only shell (disabled means zero Supabase calls)
NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=false
# Manual character backup/restore (independent, disabled by default)
NEXT_PUBLIC_SUPABASE_CHARACTER_BACKUP_ENABLED=false
# Automatic character sync (independent, disabled by default)
NEXT_PUBLIC_SUPABASE_CHARACTER_AUTOMATIC_SYNC_ENABLED=false
# DM cloud workspace identity (independent, disabled by default)
NEXT_PUBLIC_SUPABASE_DM_WORKSPACE_ENABLED=false
# Scoped hybrid guest sessions (server capability and UI are independently off)
SUPABASE_HYBRID_GUEST_ENABLED=false
NEXT_PUBLIC_SUPABASE_HYBRID_GUEST_UI_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
GUEST_SESSION_PEPPER=
NEXT_PUBLIC_INDEXEDDB_MIGRATION_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_public_turnstile_site_key

NEXT_PUBLIC_SUPABASE_AUTH_ENABLED=true
NEXT_PUBLIC_CHARACTER_INDEXEDDB_CUTOVER_ENABLED=true
NEXT_PUBLIC_SUPABASE_CHARACTER_AUTOMATIC_SYNC_ENABLED=true

NEXT_PUBLIC_SUPABASE_CHARACTER_BACKUP_ENABLED=false
NEXT_PUBLIC_INDEXEDDB_MIGRATION_ENABLED=false
