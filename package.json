{
  "name": "rollkeeper",
  "version": "0.1.0",
  "private": true,
  "description": "A web-based D&D character sheet application with auto-save functionality and calculated fields",
  "keywords": [
    "dnd",
    "character-sheet",
    "rpg",
    "nextjs",
    "typescript"
  ],
  "author": "Irakli Iremashvili",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "node scripts/quality-ratchet.mjs lint",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "format": "npm run prettier && npm run lint:fix",
    "format:check": "npm run prettier:check && npm run lint",
    "format:ci": "node scripts/quality-ratchet.mjs format",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test:indexeddb:e2e": "playwright test --config playwright.indexeddb.config.ts",
    "test:automatic-sync:e2e": "playwright test --config playwright.automatic-sync.config.ts",
    "test:slice8:coverage": "vitest run --config vitest.slice8.config.ts",
    "test:slice9:coverage": "vitest run --config vitest.slice9.config.ts",
    "test:slice10a1:coverage": "vitest run --config vitest.slice10a1.config.ts",
    "test:slice10a2:coverage": "vitest run --config vitest.slice10a2.config.ts",
    "test:slice10b:coverage": "vitest run --config vitest.slice10b.config.ts",
    "test:slice11a:coverage": "vitest run --config vitest.slice11a.config.ts",
    "test:slice11b:coverage": "vitest run --config vitest.slice11b.config.ts",
    "test:slice11c:coverage": "vitest run --config vitest.slice11c.config.ts",
    "test:slice11d:coverage": "vitest run --config vitest.slice11d.config.ts",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "test:watch": "vitest --project unit",
    "test:visual": "vitest run --project storybook",
    "test:all": "vitest run",
    "test:ci-tools": "node --test scripts/quality-ratchet.test.mjs",
    "test:db:integration": "node --test scripts/supabase-integration.test.mjs",
    "test:guest:http": "node --test scripts/guest-http.integration.test.mjs",
    "test:membership:integration": "node --test scripts/membership-cutover.integration.test.mjs",
    "test:membership:http": "node --test scripts/membership-http.integration.test.mjs",
    "test:campaign-settings:integration": "node --test scripts/campaign-settings.integration.test.mjs",
    "test:campaign-settings:http": "node --test scripts/campaign-settings-http.integration.test.mjs",
    "test:campaign-settings:redis": "node --test scripts/campaign-settings-redis.integration.test.mjs",
    "test:calendar:integration": "node --test scripts/calendar-documents.integration.test.mjs",
    "test:calendar:redis": "node --test scripts/calendar-redis.integration.test.mjs",
    "test:magic-item:integration": "node --test scripts/magic-item-documents.integration.test.mjs",
    "test:npc:integration": "node --test scripts/npc-documents.integration.test.mjs",
    "test:auth:integration": "node --test scripts/supabase-auth.integration.test.mjs",
    "test:db:replay": "node --test scripts/supabase-reset-replay.test.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public | prettier --parser typescript > src/types/database.generated.ts",
    "db:types:check": "node scripts/verify-supabase-types.mjs",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.3",
    "@3d-dice/dice-ui": "^0.5.2",
    "@aws-sdk/client-s3": "^3.922.0",
    "@fieldnotes/core": "^0.63.0",
    "@fieldnotes/react": "^0.11.0",
    "@fieldnotes/sync": "^0.11.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-form": "^0.1.7",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/extension-bullet-list": "^3.0.3",
    "@tiptap/extension-color": "^3.0.3",
    "@tiptap/extension-list-item": "^3.0.3",
    "@tiptap/extension-ordered-list": "^3.0.3",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-text-style": "^3.0.3",
    "@tiptap/extension-underline": "^3.13.0",
    "@tiptap/react": "^3.0.3",
    "@tiptap/starter-kit": "^3.0.3",
    "@upstash/redis": "^1.36.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "frimousse": "^0.3.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.553.0",
    "next": "^16.3.1",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.60.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.3.1",
    "tldraw": "^4.4.1",
    "zod": "^4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.1.9",
    "@storybook/addon-docs": "^10.1.9",
    "@storybook/addon-onboarding": "^10.1.9",
    "@storybook/addon-vitest": "^10.2.16",
    "@storybook/nextjs-vite": "^10.1.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-storybook": "^10.1.9",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.1.5",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^10.1.9",
    "supabase": "2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  }
}
